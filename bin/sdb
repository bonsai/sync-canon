#!/bin/bash
set -euo pipefail

# sync-db CLI — toolkit only. Data lives in SC_DATA_ROOT (e.g. kankyou-hub/sync-data)
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DEVICE="${SC_DEVICE:-wsl}"
ENV_ID="${SC_ENV_ID:-$DEVICE}"
DATA_ROOT="${SC_DATA_ROOT:-$ROOT}"

_usage() {
  cat <<EOF
sdb — sync-db unified CLI (toolkit mode)

Data is NOT stored in this repo. Set SC_DATA_ROOT to your private data repo.

Usage: sdb <command> [args]

Data Layer ($DATA_ROOT/.devices/)
  sdb export <db-path> [device] [name]    DB → canonical
  sdb import <name> [device] [db-path]    canonical → DB

Chat Memory Layer ($DATA_ROOT/.memories/)
  sdb memory extract [device]             mine agent sessions
  sdb memory ingest [device]              ingest to talk-db format

Environment ($DATA_ROOT/.env/)
  sdb env capture [env_id]                snapshot environment
  sdb env diff <env1> <env2>              compare environments

Sync
  sdb push [device]                       git commit + push data dir
  sdb pull                                git pull origin main

Inspect
  sdb status                              show device/layer state
  sdb list [device]                       list canonical exports

Environment:
  SC_DEVICE=wsl          target device label
  SC_ENV_ID=pc1-wsl      environment identifier
  SC_DATA_ROOT=path      where .devices/ and .memories/ live
EOF
}

_cmd_export() {
  local db_path="${1:-}"
  local dev="${2:-$DEVICE}"
  local name="${3:-$(basename "$db_path" .db)}"
  [ -z "$db_path" ] && { echo "Usage: sdb export <db-path> [device] [name]"; exit 1; }
  [ ! -f "$db_path" ] && { echo "DB not found: $db_path"; exit 1; }
  python3 "$ROOT/scripts/export.py" "$db_path" "$dev" "$name" --out-root "$DATA_ROOT"
}

_cmd_import() {
  local name="${1:-}"
  local dev="${2:-$DEVICE}"
  local db_path="${3:-}"
  [ -z "$name" ] && { echo "Usage: sdb import <name> [device] [db-path]"; exit 1; }
  if [ -z "$db_path" ]; then
    case "$name" in
      talk-db) db_path="$HOME/repos/talk-db/db/talk.db" ;;
      wf-errors) db_path="$HOME/repos/wf-errors/wferr.db" ;;
      .agents) db_path="$HOME/repos/.agents/data/triage.db" ;;
      *) echo "Unknown DB name: $name"; exit 1 ;;
    esac
  fi
  python3 "$ROOT/scripts/import.py" "$dev" "$name" "$db_path" --in-root "$DATA_ROOT"
}

_cmd_memory_extract() {
  local dev="${1:-$DEVICE}"
  python3 "$ROOT/scripts/extract_memories.py" "$dev" --out-root "$DATA_ROOT/.memories"
}

_cmd_memory_ingest() {
  local dev="${1:-$DEVICE}"
  python3 "$ROOT/scripts/ingest_memories.py" "$dev" --memories-root "$DATA_ROOT/.memories" --out-dir "$DATA_ROOT/data/memory_ingest"
}

_cmd_env_capture() {
  local env="${1:-$ENV_ID}"
  [ -z "$env" ] && { echo "Usage: sdb env capture [env_id] (or set SC_ENV_ID)"; exit 1; }
  python3 "$ROOT/scripts/env_capture.py" capture "$env" --out-root "$DATA_ROOT"
}

_cmd_env_diff() {
  local env1="${1:-}"
  local env2="${2:-}"
  [ -z "$env1" ] && { echo "Usage: sdb env diff <env1> <env2>"; exit 1; }
  python3 "$ROOT/scripts/env_capture.py" diff "$env1" "$env2" --data-root "$DATA_ROOT"
}

_cmd_push() {
  local dev="${1:-$DEVICE}"
  cd "$DATA_ROOT"
  git add ".devices/$dev/" 2>/dev/null || true
  git add ".memories/$dev/" 2>/dev/null || true
  git add ".env/" 2>/dev/null || true
  git add "data/" 2>/dev/null || true
  git commit -m "sync($dev): $(date +%Y%m%d-%H%M)" || true
  git push origin main
}

_cmd_pull() {
  cd "$DATA_ROOT"
  git pull origin main
}

_cmd_status() {
  echo "=== sync-db status ==="
  echo "Toolkit: $ROOT"
  echo "Data:    $DATA_ROOT"
  echo "Device:  $DEVICE"
  echo "Git:     $(cd "$DATA_ROOT" 2>/dev/null && git rev-parse --short HEAD 2>/dev/null || echo 'n/a')"
  echo ""

  if [ -d "$DATA_ROOT/.devices/$DEVICE" ]; then
    local tables=$(find "$DATA_ROOT/.devices/$DEVICE" -name "schema.sql" | wc -l)
    echo "[$DEVICE] .devices/  │ $tables DB(s)"
  else
    echo "[$DEVICE] .devices/  │ (none)"
  fi

  if [ -d "$DATA_ROOT/.memories/$DEVICE" ]; then
    local frags=$(find "$DATA_ROOT/.memories/$DEVICE" -name "*.jsonl" -exec cat {} + 2>/dev/null | wc -l)
    echo "[$DEVICE] .memories/ │ $frags fragment(s)"
  else
    echo "[$DEVICE] .memories/ │ (none)"
  fi

  if [ -d "$DATA_ROOT/.env/$DEVICE" ] || [ -d "$DATA_ROOT/.env/$ENV_ID" ]; then
    echo "[$DEVICE] .env/      │ captured"
  else
    echo "[$DEVICE] .env/      │ (none)"
  fi
}

_cmd_list() {
  local dev="${1:-$DEVICE}"
  echo "=== $DATA_ROOT/.devices/$dev ==="
  find "$DATA_ROOT/.devices/$dev" -maxdepth 2 -name "schema.sql" -print 2>/dev/null | while read -r f; do
    local dir=$(dirname "$f")
    local name=$(basename "$dir")
    local rows=$(find "$dir" -name "*.jsonl" -exec cat {} + 2>/dev/null | wc -l)
    echo "  $name/  rows: $rows"
  done
  echo ""
  echo "=== $DATA_ROOT/.memories/$dev ==="
  find "$DATA_ROOT/.memories/$dev" -name "*.jsonl" -print 2>/dev/null | while read -r f; do
    local frags=$(wc -l < "$f")
    echo "  $(basename "$f")  fragments: $frags"
  done
}

# dispatch
CMD="${1:-help}"; shift || true
case "$CMD" in
  export)      _cmd_export "$@" ;;
  import)      _cmd_import "$@" ;;
  memory-extract|mem-extract|me) _cmd_memory_extract "$@" ;;
  memory-ingest|mem-ingest|mi)   _cmd_memory_ingest "$@" ;;
  env)         SUB="${1:-help}"; shift || true
                case "$SUB" in
                  capture|c)  _cmd_env_capture "$@" ;;
                  diff|d)     _cmd_env_diff "$@" ;;
                  *)           echo "Usage: sdb env capture|diff"; exit 1 ;;
                esac
                ;;
  push)        _cmd_push "$@" ;;
  pull)        _cmd_pull ;;
  status|st)   _cmd_status ;;
  list|ls)     _cmd_list "$@" ;;
  help|--help|-h) _usage ;;
  *) echo "Unknown command: $CMD"; _usage; exit 1 ;;
esac
